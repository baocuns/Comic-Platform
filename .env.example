# ── App ──
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ── Database (Railway PostgreSQL) ──
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Redis (Railway / Standard Redis) ──
REDIS_URL=redis://default:password@host:port

# ── Auth ──
JWT_SECRET=your-jwt-secret-at-least-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-at-least-32-chars
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# ── OAuth (Google) ──
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Storage (Cloudflare R2) ──
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=comic-platform
R2_PUBLIC_URL=https://your-account-id.r2.cloudflarestorage.com
CDN_URL=http://localhost:4000/uploads

# ── Monitoring (Optional) ──
# SENTRY_DSN=
